<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valor_Por_Vida_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
  ISBLANK(Valor_Por_Vida__c),
  Valor_Por_Vida__c &lt;= 0
)</errorConditionFormula>
    <errorDisplayField>Valor_Por_Vida__c</errorDisplayField>
    <errorMessage>O valor por vida deve ser maior que zero.</errorMessage>
</ValidationRule>
